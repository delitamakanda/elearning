{
  "mcpServers": {
    "playwright": {
      "command": "playwright-mcp",
      "args": [
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--viewport-size",
        "1280x800",
        "--caps",
        "testing",
        "--allowed-origins",
        "http://localhost:8000;http://127.0.0.1:8000",
        "--output-dir",
        ".agent-out/playwright"
      ]
    }
  }
}
